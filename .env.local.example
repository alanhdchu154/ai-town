LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
TIME_SPEED=60

# ---------------------------------------------------------------------------
# GIIS Underworld v0.1 pilot knobs (all OFF by default).
# Only set these when you are intentionally running the soul-triad pilot
# scripts. The pilot scripts in scripts/run-*-single-sample.mjs set and
# clear these for you. See docs/giis-v0.1-roadmap.md for the fresh-sample
# rule that governs when (and when NOT) to act on what they collect.
# ---------------------------------------------------------------------------

# Soul-triad pilot gates
# UMI_MAHIRU_COLOCATION_PILOT=true            # Umi <-> Mahiru only
# SOUL_TRIAD_COLOCATION_PILOT=true            # Umi / Mahiru / Tianze trio
# UMI_MAHIRU_SINGLE_SAMPLE_AFTER_MS=240000    # close Umi-Mahiru window after N ms
# SOUL_TRIAD_SINGLE_SAMPLE_AFTER_MS=240000    # close triad window after N ms
# SOUL_TRIAD_FOCUS_PAIR=Mahiru:Tianze         # force one dyad to be sampled
# SOUL_PILOT_PAIR_COOLDOWN_MS=600000          # min same-pair gap during live pilot
#                                                (single-sample runner overrides to 60000ms by default)

# Cloud LLM for the pilot (Qwen via OpenAI-compatible proxy)
# UMI_MAHIRU_PILOT_PROVIDER=qwen
# UMI_MAHIRU_PILOT_MODEL=qwen3-max
# UMI_MAHIRU_PILOT_API_KEY=...
# UMI_MAHIRU_PILOT_API_KEY_BACKUP=...
# UMI_MAHIRU_PILOT_BASE_URL=https://api.newcoin.top
# UMI_MAHIRU_PILOT_TIMEOUT_MS=35000
# UMI_MAHIRU_PILOT_DAILY_QUOTA=24

# Per-pair LLM allowlist for autonomous (non-Alan) conversations
# AUTONOMOUS_CONVERSATION_LLM_PAIRS=Umi:Mahiru,Umi:Tianze,Mahiru:Tianze,Tianze:Ichinose

# AUTONOMOUS LLM DEFAULT-ON FOR OLLAMA SETUPS
# -------------------------------------------
# Since the abort-everywhere change in convex/agent/conversation.ts,
# deterministic fallback dialogue is never archived — it returns
# `[ABORT_CONVERSATION] ...` which the persistence gates drop. If
# autonomous LLM is off, non-pilot NPC↔NPC conversations therefore
# produce nothing at all (silent world).
#
# To keep the simulation alive on local setups, autonomousConversationLLM
# is now DEFAULT-ON whenever any of these is set:
#   LLM_PROVIDER=ollama
#   OLLAMA_MODEL=...
#   CONVERSATION_FAST_MODEL=...
#
# Resource impact: every autonomous NPC↔NPC conversation hits the local
# LLM. If your Ollama box is under load, expect higher GPU/CPU usage and
# slower world tick.
#
# To opt out (NPC↔NPC conversations stay silent, only pilot pairs talk):
# AUTONOMOUS_CONVERSATION_LLM=false
#
# To explicitly opt in even without Ollama configured:
# AUTONOMOUS_CONVERSATION_LLM=true

# Emotional residue loop (Phase 1, shipped 2026-05-26). Defaults to ON.
# Set to false to fully disable without code change.
# UNDERWORLD_RESIDUE_WRITE=false              # skip writing 殘留：... line
# UNDERWORLD_RESIDUE_READ=false               # skip injecting residue into prompts
# UNDERWORLD_RESIDUE_RESONANCE=false          # skip soul-resonance gating on writes
