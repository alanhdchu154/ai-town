{
  "name": "ai-town",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "predev": "CONVEX_LOCAL_BACKEND_STARTUP_TIMEOUT_SECS=180 convex dev --run init --until-success",
    "dev:backend": "CONVEX_LOCAL_BACKEND_STARTUP_TIMEOUT_SECS=180 convex dev --tail-logs",
    "dev:frontend": "vite",
    "dashboard": "convex dashboard",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "eval:conversation": "node --loader ts-node/esm evals/conversations/runConversationEval.ts",
    "eval:conversation:recent": "node --loader ts-node/esm evals/conversations/runRecentConversationEval.ts",
    "eval:conversation:loop": "node --loader ts-node/esm evals/conversations/runConversationEvalLoop.ts",
    "eval:umi-mahiru": "node --loader ts-node/esm evals/conversations/runUmiMahiruEval.ts",
    "eval:umi-mahiru:soul-loop": "bash umi/umi_mahiru_soul_depth_30min_loop.sh",
    "eval:soul-triad": "node --loader ts-node/esm evals/conversations/runSoulTriadEval.ts",
    "eval:soul-triad:hourly": "bash umi/soul_triad_hourly_eval_until_sleep.sh",
    "eval:soul-qa-loop": "node scripts/run-soul-qa-loop.mjs",
    "underworld:observe": "node scripts/underworld-observe-once.mjs",
    "underworld:repair-gate": "node scripts/underworld-repair-gate.mjs",
    "underworld:am-pm-continuity": "node scripts/underworld-am-pm-continuity.mjs",
    "underworld:cleanup-fallback-pollution:dry-run": "node scripts/underworld-cleanup-fallback-pollution.mjs",
    "underworld:approach:v01": "node scripts/underworld-approach-v01.mjs",
    "pilot:umi-mahiru:single-sample": "node scripts/run-umi-mahiru-single-sample.mjs",
    "pilot:soul-triad:single-sample": "node scripts/run-soul-triad-single-sample.mjs",
    "umi:dry-run": "python umi/orchestrator.py run umi/workload.md --dry-run",
    "umi:cc": "python umi/orchestrator.py run umi/workload.md --skip-codex",
    "umi:cc:write": "python umi/orchestrator.py run umi/workload.md --skip-codex --write",
    "level-editor": "vite src/editor/",
    "le": "vite src/editor/"
  },
  "dependencies": {
    "@clerk/clerk-react": "^4.27.0",
    "@pixi/react": "^7.1.0",
    "@pixi/sound": "^5.2.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "20.2.5",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "clsx": "^2.0.0",
    "convex": "^1.19.2",
    "dotenv": "^16.1.4",
    "eslint": "8.42.0",
    "hnswlib-node": "^1.4.2",
    "pixi-viewport": "^5.0.1",
    "pixi.js": "^7.2.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-github-btn": "^1.4.0",
    "react-modal": "^3.16.1",
    "react-toastify": "^9.1.3",
    "replicate": "^0.18.0",
    "typescript": "5.1.3",
    "update-browserslist-db": "^1.1.2",
    "uplot": "^1.6.25",
    "usehooks-ts": "^2.9.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.2.14",
    "@types/css-font-loading-module": "^0.0.8",
    "@types/jest": "^29.5.4",
    "@types/react-modal": "^3.16.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "vite": "^4.4.9"
  },
  "type": "module"
}
